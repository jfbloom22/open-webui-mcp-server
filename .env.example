# Required: the Open WebUI instance this MCP server manages.
OPENWEBUI_URL=https://webui.workplacelabs.io

# Required: a local-only Open WebUI management API key. Never commit the real value.
OPENWEBUI_API_KEY=

# Local default for one MCP client process. Use the shared HTTP manager when
# multiple Codex chats or Cursor sessions need the server at the same time.
MCP_TRANSPORT=stdio

# Shared local HTTP settings. The Podman manager overrides host and port for
# its container and creates MCP_HTTP_TOKEN when it is missing.
# MCP_TRANSPORT=http
# MCP_HTTP_HOST=0.0.0.0
# MCP_HTTP_PORT=8000
# MCP_HTTP_PATH=/mcp
# MCP_HTTP_TOKEN=
