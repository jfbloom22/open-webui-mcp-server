# Required: the Open WebUI instance this MCP server manages.
OPENWEBUI_URL=https://webui.workplacelabs.io

# Required: a local-only Open WebUI management API key. Never commit the real value.
OPENWEBUI_API_KEY=

# Local default: each MCP client launches its own stdio container.
MCP_TRANSPORT=stdio

# Optional future shared-local-server settings. Use only with MCP_TRANSPORT=http.
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=8000
# MCP_HTTP_PATH=/mcp
# MCP_HTTP_TOKEN=generate-a-long-random-local-token
